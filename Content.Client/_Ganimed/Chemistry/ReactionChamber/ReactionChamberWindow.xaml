<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'reaction-chamber-window-title'}"
                      MinSize="900 520"
                      SetSize="920 540">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6 6 6 8" HorizontalExpand="True">
        <BoxContainer Name="TransferAmountRow" Access="Public" Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
            <Label Text="{Loc 'reaction-chamber-window-transfer-amount'}" StyleClasses="LabelKeyText" />
            <LineEdit Name="AmountLineEdit" Access="Public" HorizontalExpand="True" PlaceHolder="{Loc 'reaction-chamber-window-transfer-placeholder'}" />
            <BoxContainer Name="AmountButtons" Access="Public" Orientation="Horizontal" SeparationOverride="4" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True" MinSize="0 32">
                    <Label Text="{Loc 'reaction-chamber-window-buffer-label'}" StyleClasses="LabelKeyText" VerticalAlignment="Center" />
                    <Control HorizontalExpand="True" />
                    <Control MinSize="80 0" />
                </BoxContainer>
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" MinSize="0 120" MaxSize="Infinity 140">
                        <BoxContainer Name="BufferContainerInfo" Access="Public" Orientation="Vertical" Margin="4" HorizontalExpand="True" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True" MinSize="0 32">
                    <Label Text="{Loc 'reaction-chamber-window-beaker-label'}" StyleClasses="LabelKeyText" VerticalAlignment="Center" />
                    <Control HorizontalExpand="True" />
                    <Button Name="EjectButton" Access="Public" Text="{Loc 'reaction-chamber-window-eject'}" MinSize="80 0" />
                </BoxContainer>
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" MinSize="0 120" MaxSize="Infinity 140">
                        <BoxContainer Name="BeakerContainerInfo" Access="Public" Orientation="Vertical" Margin="4" HorizontalExpand="True" />
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>

        <RichTextLabel Name="StatusLabel" Access="Public" StyleClasses="LabelSubText" Margin="0 4 0 0" HorizontalExpand="True" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True" Margin="0 4 0 0">
            <Button Name="ConfigureProgramsButton" Access="Public" Text="{Loc 'reaction-chamber-window-configure-programs'}" MinSize="160 0" />
            <Label Text="{Loc 'reaction-chamber-window-program-label'}" VerticalAlignment="Center" />
            <OptionButton Name="ProgramSelector" Access="Public" HorizontalExpand="True" />
            <Button Name="StartButton" Access="Public" Text="{Loc 'reaction-chamber-window-start'}" MinSize="90 0" />
            <Button Name="StopButton" Access="Public" Text="{Loc 'reaction-chamber-window-stop'}" MinSize="90 0" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
