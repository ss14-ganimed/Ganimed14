<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'hplc-window-title'}"
                      MinSize="880 435"
                      SetSize="900 445">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6 6 6 8" HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">
            <Label Text="{Loc 'hplc-window-input-label'}" StyleClasses="LabelKeyText" />
            <Control HorizontalExpand="True" />
            <Button Name="EjectButton" Access="Public" Text="{Loc 'hplc-window-eject'}" MinSize="80 0" />
        </BoxContainer>
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer Name="InputScroll" Access="Public" HScrollEnabled="False" HorizontalExpand="True" MinSize="860 100" MaxSize="Infinity 120">
                <BoxContainer Name="InputContainerInfo" Access="Public" Orientation="Vertical" Margin="4" HorizontalExpand="True" />
            </ScrollContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 2 0 0" HorizontalExpand="True">
            <Label Text="{Loc 'hplc-window-output-label'}" StyleClasses="LabelKeyText" />
            <Control HorizontalExpand="True" />
            <Button Name="OutputEjectButton" Access="Public" Text="{Loc 'hplc-window-eject'}" MinSize="80 0" />
        </BoxContainer>
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer Name="OutputScroll" Access="Public" HScrollEnabled="False" HorizontalExpand="True" MinSize="860 100" MaxSize="Infinity 120">
                <BoxContainer Name="OutputContainerInfo" Access="Public" Orientation="Vertical" Margin="4" HorizontalExpand="True" />
            </ScrollContainer>
        </PanelContainer>

        <RichTextLabel Name="EtaLabel" Access="Public" StyleClasses="LabelSubText" Margin="0 4 0 0" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Right" Margin="0 2 0 2">
            <Button Name="StartButton" Access="Public" Text="{Loc 'hplc-window-start'}" MinSize="90 0" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
