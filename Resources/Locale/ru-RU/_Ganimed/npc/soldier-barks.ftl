# Радиопереговоры солдат. Переменная $dir - направление ("на севере", "поблизости").

soldier-direction-north = на севере
soldier-direction-east = на востоке
soldier-direction-south = на юге
soldier-direction-west = на западе
soldier-direction-unknown = поблизости

# Подозрение и проверка шума
soldier-bark-heard-gunfire-1 = Слышу стрельбу { $dir }!
soldier-bark-heard-gunfire-2 = Выстрелы { $dir }! Всем внимание!
soldier-bark-heard-gunfire-3 = Кто-то стреляет { $dir }, надо проверить.
soldier-bark-heard-gunfire-4 = Стрельба { $dir }! Это не наши.

soldier-bark-heard-explosion-1 = Взрыв { $dir }! Что там такое?
soldier-bark-heard-explosion-2 = Громыхнуло { $dir }! Всем внимание!
soldier-bark-heard-explosion-3 = Был взрыв { $dir }, нужно проверить.
soldier-bark-heard-explosion-4 = Слышал подрыв { $dir }! Это не учения.

soldier-bark-arrived-1 = На месте. Осматриваюсь.
soldier-bark-arrived-2 = Прибыл. Начинаю осмотр.
soldier-bark-arrived-3 = Я на точке, проверяю периметр.

soldier-bark-all-clear-1 = База, противник не обнаружен.
soldier-bark-all-clear-2 = Осмотр закончен. Ничего не нашли.
soldier-bark-all-clear-3 = Чисто. Противника не обнаружено.
soldier-bark-all-clear-4 = Сектор проверен, угроз нет.

soldier-bark-clear-1 = Чисто!
soldier-bark-clear-2 = Помещение чисто.
soldier-bark-clear-3 = Тут чисто.

soldier-bark-returning-to-post-1 = Возвращаемся на пост.
soldier-bark-returning-to-post-2 = Отхожу на позицию.
soldier-bark-returning-to-post-3 = Назад на пост, конец связи.

# Контакт и уровни тревоги
soldier-bark-contact-1 = Контакт { $dir }!
soldier-bark-contact-2 = Вижу противника { $dir }! Контакт!
soldier-bark-contact-3 = Контакт! Противник { $dir }!
soldier-bark-contact-4 = Нарушитель { $dir }! Открываю огонь!

soldier-bark-lost-target-1 = Потерял цель!
soldier-bark-lost-target-2 = Противник скрылся из виду!
soldier-bark-lost-target-3 = Цель ушла, не вижу его!

soldier-bark-evasion-1 = Прочёсываем сектор, не расслабляться!
soldier-bark-evasion-2 = Ищем, он где-то рядом.
soldier-bark-evasion-3 = Всем искать, глаза открыты!

soldier-bark-stand-down-1 = Отбой тревоги. Оставаться начеку.
soldier-bark-stand-down-2 = Противник не найден. Отбой, но будьте внимательны.
soldier-bark-stand-down-3 = Тревога снижена. Не расслабляться.

soldier-bark-controlled-1 = Контроль!
soldier-bark-controlled-2 = Цель нейтрализована, контроль.
soldier-bark-controlled-3 = Ситуация под контролем.

soldier-bark-man-down-1 = Боец ранен! Потеряли человека!
soldier-bark-man-down-2 = У нас потери! Внимание!
soldier-bark-man-down-3 = Свой на земле! Будьте осторожны!

# Тактика
soldier-bark-reloading-1 = Перезаряжаюсь, прикройте!
soldier-bark-reloading-2 = Магазин! Перезаряжаюсь!
soldier-bark-reloading-3 = Смена магазина, прикрой!

soldier-bark-grenade-1 = Граната!
soldier-bark-grenade-2 = Бросаю гранату, ложись!
soldier-bark-grenade-3 = Граната пошла!

soldier-bark-suppressing-1 = Прикрываю, работайте!
soldier-bark-suppressing-2 = Подавляю! Двигайтесь!
soldier-bark-suppressing-3 = Держу его огнём!

soldier-bark-flanking-1 = Обхожу с фланга!
soldier-bark-flanking-2 = Иду в обход!
soldier-bark-flanking-3 = Захожу сбоку, прикройте!

soldier-bark-entering-1 = Захожу!
soldier-bark-entering-2 = Вхожу, прикрой!
soldier-bark-entering-3 = Заходим, готовность!

soldier-bark-wounded-1 = Я ранен! Нужна помощь!
soldier-bark-wounded-2 = Задели! Отхожу!
soldier-bark-wounded-3 = Меня зацепило, прикройте!

soldier-bark-healing-1 = Лечусь, прикройте!
soldier-bark-healing-2 = Ставлю повязку, прикрой!
soldier-bark-healing-3 = Перевязка, дайте минуту!

# Медик
soldier-bark-call-medic-1 = Медик! Боец на земле, быстро сюда!
soldier-bark-call-medic-2 = Нужен медик! Свой в критическом состоянии!
soldier-bark-call-medic-3 = Медика сюда, у нас раненый!

soldier-bark-medic-coming-1 = Иду к раненому, прикройте!
soldier-bark-medic-coming-2 = Медик выдвигается, держитесь!
soldier-bark-medic-coming-3 = Вижу его, бегу!

soldier-bark-medic-dragging-1 = Взял его, вытаскиваю!
soldier-bark-medic-dragging-2 = Тащу в укрытие, не давайте им высунуться!
soldier-bark-medic-dragging-3 = Выношу раненого с линии огня!

soldier-bark-medic-treating-1 = Работаю, дайте место!
soldier-bark-medic-treating-2 = Держись, сейчас поставлю на ноги!
soldier-bark-medic-treating-3 = Накладываю повязку, потерпи!

soldier-bark-medic-done-1 = Стабилизирован!
soldier-bark-medic-done-2 = Он снова на ногах!
soldier-bark-medic-done-3 = Поднял его, дальше он сам!

# Командование: доклады солдат и ответы командира. Слова ситуации: $dir (где), $dist (как далеко, в метрах),
# $names (кому приказ), $who (о ком речь), $count (сколько), $text (что передают дальше).

soldier-bark-contact-many-1 = Контакт { $dir }! Вижу { $count } целей!
soldier-bark-contact-many-2 = Группа противника { $dir }: { $count } человек!
soldier-bark-contact-many-3 = Много целей { $dir }, насчитал { $count }! Веду огонь!

soldier-bark-status-ready-1 = { $who }, на связи, в порядке.
soldier-bark-status-ready-2 = { $who } на посту, всё спокойно.
soldier-bark-status-ready-3 = { $who } докладывает: цел, готов к работе.

soldier-bark-status-wounded-1 = { $who }, ранен, держусь.
soldier-bark-status-wounded-2 = { $who } докладывает: ранен, продолжаю.
soldier-bark-status-wounded-3 = { $who }: нужна помощь, но я на ногах.

soldier-bark-status-fighting-1 = { $who }, веду бой!
soldier-bark-status-fighting-2 = { $who } в бою, не отвлекайте!
soldier-bark-status-fighting-3 = { $who } занят, работаю по цели!

soldier-bark-declined-1 = Не могу, занят!
soldier-bark-declined-2 = Выполнить не могу, веду бой!
soldier-bark-declined-3 = Отказ, у меня другое дело!

soldier-bark-ack-1 = Принял.
soldier-bark-ack-2 = Понял, выполняю.
soldier-bark-ack-3 = Есть!

soldier-bark-relay-1 = Передаю: { $text }
soldier-bark-relay-2 = Для штаба, повторяю: { $text }
soldier-bark-relay-3 = Ретранслирую: { $text }

soldier-bark-link-lost-1 = Нет связи со штабом! Держимся вместе!
soldier-bark-link-lost-2 = Связь потеряна, собираемся группой!
soldier-bark-link-lost-3 = Штаб молчит! Всем держаться рядом, говорим голосом!

soldier-bark-order-alert-1 = Всем постам, тревога! Противник { $dir }, { $dist } м.
soldier-bark-order-alert-2 = Внимание, всем! Контакт { $dir }, поднимаю отряд.
soldier-bark-order-alert-3 = Тревога! Противник { $dir }, всем быть наготове.

soldier-bark-order-investigate-1 = { $names }, проверьте { $dir }, { $dist } м. Остальным оставаться на постах.
soldier-bark-order-investigate-2 = { $names }, выдвигайтесь { $dir } и осмотрите место.
soldier-bark-order-investigate-3 = { $names }, на проверку { $dir }. Без самодеятельности.

soldier-bark-order-reinforce-1 = { $names }, на подмогу! Контакт { $dir }, { $dist } м.
soldier-bark-order-reinforce-2 = { $names }, срочно к контакту { $dir }!
soldier-bark-order-reinforce-3 = { $names }, поддержите огнём { $dir }!

soldier-bark-order-search-1 = { $names }, прочесать сектор { $dir }.
soldier-bark-order-search-2 = { $names }, ищите противника { $dir }, { $dist } м.
soldier-bark-order-search-3 = { $names }, обыскать { $dir }. Докладывайте.

soldier-bark-order-intercept-1 = { $names }, перехват { $dir }! Он идёт туда.
soldier-bark-order-intercept-2 = { $names }, перекройте путь { $dir }.
soldier-bark-order-intercept-3 = { $names }, встречайте его { $dir }.

soldier-bark-order-post-1 = { $names }, занять позицию { $dir }.
soldier-bark-order-post-2 = { $names }, на пост { $dir }, держать сектор.
soldier-bark-order-post-3 = { $names }, новая позиция { $dir }, { $dist } м.

soldier-bark-order-suppress-1 = { $names }, прикрывай огнём, остальные двигаются!
soldier-bark-order-suppress-2 = { $names }, подавляй противника!
soldier-bark-order-suppress-3 = { $names }, держи его огнём, не давай высунуться!

soldier-bark-order-flank-1 = { $names }, в обход! Заходи ему во фланг.
soldier-bark-order-flank-2 = { $names }, пойдёшь в обход, мы прикроем.
soldier-bark-order-flank-3 = { $names }, зайди сбоку и добей.

soldier-bark-order-fallback-1 = { $names }, отход! Ко мне, прикрывая друг друга.
soldier-bark-order-fallback-2 = { $names }, отходим, не лезьте под огонь!
soldier-bark-order-fallback-3 = { $names }, оторваться от противника и отойти!

soldier-bark-order-assault-1 = { $names }, отставить отход! Работаем по противнику.
soldier-bark-order-assault-2 = { $names }, возвращайтесь в бой!
soldier-bark-order-assault-3 = { $names }, держим позицию, огонь!

soldier-bark-order-medic-1 = { $names }, { $who } лежит { $dir }, { $dist } м. Быстро к нему!
soldier-bark-order-medic-2 = Медик { $names }, раненый { $who } { $dir }, вытаскивай!
soldier-bark-order-medic-3 = { $names }, срочно к { $who } { $dir }!

soldier-bark-roll-call-1 = Всем постам, доложить обстановку.
soldier-bark-roll-call-2 = { $names }, доложите, как слышите.
soldier-bark-roll-call-3 = Перекличка! Всем отозваться.

soldier-bark-ack-report-1 = Принял, { $who }.
soldier-bark-ack-report-2 = { $who }, понял тебя.
soldier-bark-ack-report-3 = Вас понял, { $who }. Работаю.

soldier-bark-assume-command-1 = Штаб молчит. { $who } принимает командование!
soldier-bark-assume-command-2 = Беру командование на себя. Слушать мои приказы!
soldier-bark-assume-command-3 = Командует { $who }! Докладывайте мне.

soldier-bark-hq-ack-report-1 = Штаб принял, { $who }.
soldier-bark-hq-ack-report-2 = { $who }, штаб тебя слышит.
soldier-bark-hq-ack-report-3 = Штаб понял, { $who }. Работайте.

soldier-bark-hq-assume-command-1 = Штаб на связи. Принимаю командование. Доложить обстановку.
soldier-bark-hq-assume-command-2 = Говорит штаб. Командование отрядом на мне.
soldier-bark-hq-assume-command-3 = Штаб в эфире. Все приказы — только от меня.

soldier-bark-order-sectors-1 = Всем постам, расходимся по секторам. Держать свою зону.
soldier-bark-order-sectors-2 = Занять сектора по плану. Каждый на своё место.
soldier-bark-order-sectors-3 = Штаб распределяет сектора. Посты занять, смотреть в оба.

soldier-bark-order-push-1 = { $names }, пуш! Противник { $dir }, { $dist } м. Заходим!
soldier-bark-order-push-2 = { $names }, давим! Противник засел { $dir } — идём на штурм.
soldier-bark-order-push-3 = { $names }, штурм { $dir }, { $dist } м. Входим по готовности!

soldier-bark-order-hold-1 = { $names }, держать вход { $dir }. Не выпускать никого.
soldier-bark-order-hold-2 = { $names }, займите проход { $dir } и удерживайте.
soldier-bark-order-hold-3 = { $names }, держите коридор { $dir }, без команды не отходить.

soldier-bark-order-cordon-1 = { $names }, перекрыть выходы { $dir }!
soldier-bark-order-cordon-2 = { $names }, кордон { $dir }: никого не выпускать.
soldier-bark-order-cordon-3 = { $names }, блокируйте двери { $dir }, он не должен уйти.

soldier-bark-order-resupply-1 = { $names }, пополнить запасы — ящик { $dir }, { $dist } м.
soldier-bark-order-resupply-2 = { $names }, к ящику снабжения { $dir }. Возьмите всё нужное.
soldier-bark-order-resupply-3 = { $names }, на склад { $dir }, { $dist } м. Пополнитесь и назад.

soldier-bark-resupplying-1 = Беру снабжение.
soldier-bark-resupplying-2 = Пополняюсь, прикройте.
soldier-bark-resupplying-3 = Пополняю запасы.

soldier-bark-restocked-1 = Запасы пополнены.
soldier-bark-restocked-2 = Снабжение получил, готов.
soldier-bark-restocked-3 = Боезапас в норме.

soldier-bark-need-supply-1 = { $who }, мало патронов и бинтов, нужно снабжение.
soldier-bark-need-supply-2 = { $who }, запасы на исходе. Нужно пополнение.
soldier-bark-need-supply-3 = { $who }, прошу снабжение: боезапас и медицина почти кончились.

soldier-bark-order-encircle-1 = { $names }, охват! Противник { $dir }, { $dist } м. Группы к дверям, ждать сигнала!
soldier-bark-order-encircle-2 = { $names }, заходим с двух сторон — противник { $dir }. Займите двери и ждите моей команды.
soldier-bark-order-encircle-3 = { $names }, обходим его { $dir }, { $dist } м. К дверям, входим по моему сигналу!

soldier-bark-order-go-1 = { $names }, пошли, пошли! Заходим!
soldier-bark-order-go-2 = { $names }, обе группы на месте — вперёд, входим!
soldier-bark-order-go-3 = { $names }, по моему сигналу — заходим!

soldier-bark-ready-1 = { $who }, у двери, готов.
soldier-bark-ready-2 = { $who } на месте, жду сигнал.
soldier-bark-ready-3 = { $who }, дверь на прицеле. Готов войти.
