ent-ClothingModsuitBackResuscitator = МОД "Реаниматолог"
    .desc = Передовой экспериментальный МОД для сотрудников медицинской службы, действующих в нестандартных условиях.
    .suffix = { "Спонсорское, HackerEasy, Ganimed" }
