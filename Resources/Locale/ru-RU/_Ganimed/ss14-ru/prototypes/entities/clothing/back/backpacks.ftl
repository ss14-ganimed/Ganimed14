ent-ClothingBackpackCluwneRemoveable = { ent-ClothingBackpackCluwne }
    .desc = { ent-ClothingBackpackCluwne.desc }
    .suffix = Снимаемый

ent-ClothingBackpackOfficerBlack = чёрный офицерский рюкзак
    .desc = Тёмный рюкзак, используемый офицерами командования. Выглядит новым.

ent-ClothingBackpackSecurityEngineer = рюкзак полевого инженера
    .desc = Взрывоустойчивый рюкзак, в ходу среди военных инженеров и сапёров.

ent-ClothingBackpackHop = рюкзак главы персонала
    .desc = Особый рюкзак, созданный для командующего персоналом, чтобы удовлетворить его потребности в стиле.

ent-ClothingBackpackChiefMedicalOfficer = рюкзак главного врача
    .desc = Стерильный рюкзак, едва вмещающий снаряжение главного врача.

ent-ClothingBackpackCargoDark = тёмный рюкзак снабжения
    .desc = Прочный рюкзак для воровства добычи.

ent-ClothingBackpackRobotics = рюкзак робототехника
    .desc = Рюкзак, разработанный специально, чтобы сварочное топливо и механический износ не могли его испортить.

ent-ClothingBackpackCoolerBag = сумка-холодильник
    .desc = Термосумка, предназначенная для поддержания температуры и свежести продуктов питания, химических веществ или биологических материалов.
