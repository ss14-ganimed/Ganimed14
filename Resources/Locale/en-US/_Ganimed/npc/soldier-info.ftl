# The "Show NPC info" panel of the sandbox panel (for admins): the alert level, the decisions and thoughts of the commander, what the soldiers do.

sandbox-window-npc-info-button = Show NPC info

soldier-info-title = NPC info
soldier-info-alert = Alert: { $level }
soldier-info-decision = Commander's decision: { $decision }
soldier-info-decision-none = Commander's decision: no reports yet
soldier-info-thoughts = Commander's thoughts:
soldier-info-interval = Refresh every:
soldier-info-interval-option = { $seconds } s
