experiment-order-ame-name = Contract: Unstable DAM Loop
experiment-order-ame-desc = Engineering requests telemetry from a DAM controller operating above its safe injection threshold.
experiment-order-species-safe-name = Contract: Crew Biochemistry Profile
experiment-order-species-safe-desc = Acquire a verified scan of <{ $species }> with <{ $reagent }> present in their bloodstream.
experiment-order-species-unsafe-name = Contract: Hazardous Biochemistry
experiment-order-species-unsafe-desc = Command requires a confirmed scan of <{ $species }> carrying high-risk reagent <{ $reagent }>.
experiment-order-vomit-name = Contract: Sanitary Irregularity
experiment-order-vomit-desc = Record and scan biological contamination of the vomit class for medical reporting.
experiment-order-ripley-name = Contract: Ripley Equipment Audit
experiment-order-ripley-desc = Submit a scan of a fully equipped Ripley-class mech.
experiment-order-pet-name = Contract: Station Fauna Census
experiment-order-pet-desc = Provide a biological scan of target specimen <{ $target }>.
experiment-order-xeno-name = Contract: Exobiological Threat Survey
experiment-order-xeno-desc = Field teams request a live scan of hostile specimen <{ $target }>.
experiment-order-vending-name = Contract: Vendor Reliability Check
experiment-order-vending-desc = Perform an initial scan of <{ $target }> in <{ $department }>, then complete a delayed verification rescan.
experiment-order-meat-name = Contract: Culinary Forensics (Meat)
experiment-order-meat-desc = Deliver 5 unique scans of meat dishes, excluding standard fried steak.
experiment-order-id-name = Contract: Thermal ID Integrity
experiment-order-id-desc = Submit a scan of an ID card after controlled microwave heat exposure.
experiment-order-baton-name = Contract: Security Cell Analysis
experiment-order-baton-desc = Provide a scan of a stun baton containing at least 5u of plasma.
experiment-order-seed-name = Contract: Mutagenic Botany Sample
experiment-order-seed-desc = Botany requests a scan of mutated seed packet <{ $target }>.
experiment-order-radcollector-name = Contract: Radiation Intake Verification
experiment-order-radcollector-desc = Capture a scan from a radiation collector while intake is at least 6 rads.
experiment-order-canister-gas-name = Contract: Strategic Gas Reserve
experiment-order-canister-gas-desc = Submit a canister scan confirming at least 500 moles of <{ $gas }>.
experiment-order-captain-id-name = Contract: Command Credentials Audit
experiment-order-captain-id-desc = Command requests an authentication scan of the captain's ID card.
experiment-order-weapon-name = Contract: Armament Registry
experiment-order-weapon-desc = Produce a certified scan of weapon platform <{ $target }>.
experiment-order-paper-signatures-name = Contract: Signature Archive
experiment-order-paper-signatures-desc = Submit a scanned document containing signatures from at least five distinct individuals.
experiment-order-bible-name = Contract: Ecclesiastical Artifact
experiment-order-bible-desc = Scan any item bearing recognized ecclesiastical component architecture.
experiment-order-fruit-dishes-name = Contract: Culinary Forensics (Fruit)
experiment-order-fruit-dishes-desc = Prepare and scan 3 fruit dishes for nutritional profiling.
experiment-order-soups-name = Contract: Culinary Forensics (Soups)
experiment-order-soups-desc = Deliver a five-item soup scan set for galley quality analysis.
experiment-order-gravity-name = Contract: Gravitational Field Control
experiment-order-gravity-desc = Provide a scan of a powered and actively generating gravity unit.
experiment-order-contraband-plants-name = Contract: Restricted Botany Survey
experiment-order-contraband-plants-desc = Submit 5 scans of contraband plant specimens.
experiment-order-combat-mech-name = Contract: Combat Mech Readiness
experiment-order-combat-mech-desc = Record a scan of fully equipped combat mech frame <{ $target }>.
experiment-order-material-name = Contract: Rare Material Assay
experiment-order-material-desc = Research requests a reference scan of material sample <{ $target }>.
